  {
    "id": "marrakech",
    "name": "Marrakech",
    "country": "Morocco",
    "flag": "🇲🇦",
    "emoji": "🫖",
    "lat": 31.6295,
    "lng": -7.9811,
    "date": "2022-11",
    "rating": 4,
    "tags": [
      "souks",
      "rooftops",
      "mint tea"
    ],
    "photos": [
      "https://picsum.photos/seed/marrakech-a/1400/900",
      "https://picsum.photos/seed/marrakech-b/900/900",
      "https://picsum.photos/seed/marrakech-c/900/900",
      "https://picsum.photos/seed/marrakech-d/900/900"
    ],
    "video": "",
    "story": "Sensory overload, in the good way and occasionally in the other way. The medina is a deliberate labyrinth and your phone's map will lie to you with total confidence.\n\nOur best hours were the quiet ones: the **Jardin Majorelle** at opening time, and long afternoons on the riad roof with a pot of tea while the call to prayer went up from four directions at slightly different times.",
    "recs": [
      {
        "kind": "eat",
        "name": "Jemaa el-Fnaa food stalls",
        "note": "Pick the busiest one with the most locals. Stall numbers change; crowds don't lie.",
        "url": ""
      },
      {
        "kind": "stay",
        "name": "Any riad inside the medina",
        "note": "Courtyard, fountain, roof terrace. The temperature drop walking in from the street is magic.",
        "url": ""
      },
      {
        "kind": "do",
        "name": "Jardin Majorelle at 8am",
        "note": "First slot of the day, before the tour buses. Book online the night before.",
        "url": ""
      },
      {
        "kind": "tip",
        "name": "Carry small notes",
        "note": "Nobody has change, ever, and it's always somehow your problem.",
        "url": ""
      }
    ]
  },
